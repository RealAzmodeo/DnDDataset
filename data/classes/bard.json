{
  "id": "bard_2024",
  "name": "Bard (2024)",
  "description": "Bards invoke magic through music, dance, and verse, excelling at inspiring allies, healing, beguiling foes, and creating illusions.",
  "hit_die": "d8",
  "primary_ability": ["Charisma"],
  "proficiencies": {
    "armor": ["Light armor"],
    "weapons": ["Simple weapons"],
    "tools": ["Choose 3 Musical Instruments"],
    "saving_throws": ["Dexterity", "Charisma"],
    "skills": {
      "choose": 3,
      "from": "any"
    }
  },
  "starting_equipment_options": [
    "(A) Leather Armor, 2 Daggers, Musical Instrument of your choice, Entertainer’s Pack, and 19 GP",
    "(B) 90 GP"
  ],
  "spellcasting_ability": "Charisma",
  "spell_slots_and_prepared_spells_progression_note": "Refer to Bard Features table in source for Cantrips Known, Prepared Spells, and Spell Slots per Level.",
  "features_by_level": {
    "1": [
      {"id": "bard_bardic_inspiration_2024", "name": "Bardic Inspiration", "description": "Inspire others via words/music/dance. Bonus Action, target creature within 60ft (can see/hear you) gains Bardic Inspiration die (d6). Once within 1 hour, on failed D20 Test, creature can roll die and add to d20. Uses = Cha mod (min 1) per Long Rest. Die becomes d8 at L5, d10 at L10, d12 at L15."},
      {"id": "bard_spellcasting_2024", "name": "Spellcasting", "description": "Access to Bard spell list. Start with 2 cantrips and 4 prepared 1st-level spells. Charisma is spellcasting ability. Can use Musical Instrument as focus."}
    ],
    "2": [
      {"id": "bard_expertise_1_2024", "name": "Expertise (Level 2)", "description": "Gain Expertise in two skill proficiencies. (Performance & Persuasion recommended)."},
      {"id": "bard_jack_of_all_trades_2024", "name": "Jack of All Trades", "description": "Add half Proficiency Bonus (round down) to any ability check using a skill proficiency you lack and that doesn’t otherwise use Proficiency Bonus."}
    ],
    "3": [
      {"id": "bard_subclass_2024", "name": "Bard Subclass", "description": "Gain a Bard subclass. (College of Lore detailed in Basic Rules)."}
    ],
    "4": [
      {"id": "bard_asi_4_2024", "name": "Ability Score Improvement", "description": "Gain Ability Score Improvement feat or other feat. Learns 1 additional cantrip."}
    ],
    "5": [
      {"id": "bard_font_of_inspiration_2024", "name": "Font of Inspiration", "description": "Regain all expended uses of Bardic Inspiration on Short or Long Rest. Can expend a spell slot to regain one Bardic Inspiration use."}
    ],
    "6": [
      {"id": "bard_subclass_feature_6_2024", "name": "Subclass Feature", "description": "Gain subclass feature."}
    ],
    "7": [
      {"id": "bard_countercharm_2024", "name": "Countercharm", "description": "If you or creature within 30ft fails save vs Charmed/Frightened, use Reaction to cause save reroll with Advantage."}
    ],
    "8": [
      {"id": "bard_asi_8_2024", "name": "Ability Score Improvement", "description": "Gain Ability Score Improvement feat or other feat."}
    ],
    "9": [
      {"id": "bard_expertise_9_2024", "name": "Expertise (Level 9)", "description": "Gain Expertise in two more skill proficiencies."}
    ],
    "10": [
      {"id": "bard_magical_secrets_2024", "name": "Magical Secrets", "description": "When Prepared Spells number increases, can choose new prepared spells from Bard, Cleric, Druid, or Wizard lists; they count as Bard spells. Learns 1 additional cantrip."},
      {"id": "bard_bardic_die_d10_2024", "name": "Bardic Inspiration (d10)", "description": "Your Bardic Inspiration die becomes a d10."}
    ],
    "11": [],
    "12": [
      {"id": "bard_asi_12_2024", "name": "Ability Score Improvement", "description": "Gain Ability Score Improvement feat or other feat."}
    ],
    "13": [],
    "14": [
      {"id": "bard_subclass_feature_14_2024", "name": "Subclass Feature", "description": "Gain subclass feature."}
    ],
    "15": [
       {"id": "bard_bardic_die_d12_2024", "name": "Bardic Inspiration (d12)", "description": "Your Bardic Inspiration die becomes a d12."}
    ],
    "16": [
      {"id": "bard_asi_16_2024", "name": "Ability Score Improvement", "description": "Gain Ability Score Improvement feat or other feat."}
    ],
    "17": [],
    "18": [
      {"id": "bard_superior_inspiration_2024", "name": "Superior Inspiration", "description": "When rolling Initiative, if you have fewer than two uses of Bardic Inspiration, regain uses until you have two."}
    ],
    "19": [
      {"id": "bard_epic_boon_2024", "name": "Epic Boon", "description": "Gain an Epic Boon feat or other feat. (Boon of Spell Recall recommended)."}
    ],
    "20": [
      {"id": "bard_words_of_creation_2024", "name": "Words of Creation", "description": "Always have Power Word Heal and Power Word Kill prepared. When casting either, can target a second creature within 10ft of the first."}
    ]
  },
