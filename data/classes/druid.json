{
  "id": "druid_2024",
  "name": "Druid (2024)",
  "description": "Druids harness the magic of animals, plants, and the four elements to heal, transform, and wield elemental destruction, revering nature above all.",
  "hit_die": "d8",
  "primary_ability": ["Wisdom"],
  "proficiencies": {
    "armor": ["Light armor", "Shields (druids will not wear armor or use shields made of metal)"],
    "weapons": ["Simple weapons"],
    "tools": ["Herbalism Kit"],
    "saving_throws": ["Intelligence", "Wisdom"],
    "skills": {
      "choose": 2,
      "from": ["Arcana", "Animal Handling", "Insight", "Medicine", "Nature", "Perception", "Religion", "Survival"]
    }
  },
  "starting_equipment_options": [
    "(A) Leather Armor, Shield, Sickle, Druidic Focus (Quarterstaff), Explorer’s Pack, Herbalism Kit, and 9 GP",
    "(B) 50 GP"
  ],
  "spellcasting_ability": "Wisdom",
  "spell_slots_and_prepared_spells_progression_note": "Refer to Druid Features table in source for Cantrips Known, Prepared Spells, and Spell Slots per Level.",
  "wild_shape_progression": {
    "uses_per_rest": {"2": 2}, "recharge": "Regain 1 on Short Rest, all on Long Rest.",
    "known_forms_max_cr_fly_speed": {
      "2": {"known": 4, "max_cr": "1/4", "fly_speed": false},
      "4": {"known": 6, "max_cr": "1/2", "fly_speed": false},
      "8": {"known": 8, "max_cr": "1", "fly_speed": true}
    }
  },
  "features_by_level": {
    "1": [
      {"id": "druid_spellcasting_2024", "name": "Spellcasting", "description": "Access to Druid spell list, prepare spells. Starts with 2 cantrips and 4 prepared 1st-level spells. Wisdom is spellcasting ability. Can use Druidic Focus."},
      {"id": "druid_druidic_2024", "name": "Druidic", "description": "Know Druidic language. Always have Speak with Animals prepared. Can use Druidic for hidden messages."},
      {"id": "druid_primal_order_2024", "name": "Primal Order", "description": "Choose Magician (1 extra Druid cantrip, bonus to Arcana/Nature checks = Wis mod) or Warden (Martial weapon & Medium armor proficiency)."}
    ],
    "2": [
      {"id": "druid_wild_shape_2024", "name": "Wild Shape", "description": "Bonus Action to shape-shift into known Beast form for hours = half Druid level. Uses and known forms/CR progress with level. See wild_shape_progression for details. Retain personality, memories, speech, Humanoid type, HP, Hit Dice, Int/Wis/Cha scores, class features, languages, feats. Use Beast_s stats but own proficiencies/Proficiency Bonus (or Beast_s if higher). No spellcasting in Beast form (concentration maintained). Equipment can merge, drop, or be worn (DM discretion)."},
      {"id": "druid_wild_companion_2024", "name": "Wild Companion", "description": "As Magic action, expend spell slot or Wild Shape use to cast Find Familiar without material components. Familiar is Fey, disappears on Long Rest."}
    ],
    "3": [
      {"id": "druid_subclass_2024", "name": "Druid Subclass", "description": "Gain a Druid subclass. (Circle of the Land detailed in Basic Rules)."}
    ],
    "4": [
      {"id": "druid_asi_4_2024", "name": "Ability Score Improvement", "description": "Gain Ability Score Improvement feat or other feat. Learns 1 additional cantrip."}
    ],
    "5": [
      {"id": "druid_wild_resurgence_2024", "name": "Wild Resurgence", "description": "Once per turn, if no Wild Shape uses left, expend a spell slot to regain one use. Once per Long Rest, expend Wild Shape use to regain a 1st-level spell slot."}
    ],
    "6": [
      {"id": "druid_subclass_feature_6_2024", "name": "Subclass Feature", "description": "Gain subclass feature."}
    ],
    "7": [
      {"id": "druid_elemental_fury_2024", "name": "Elemental Fury", "description": "Choose: Potent Spellcasting (add Wis mod to Druid cantrip damage) OR Primal Strike (once/turn, hit with weapon/Wild Shape attack adds 1d8 Cold, Fire, Lightning, or Thunder damage)."}
    ],
    "8": [
      {"id": "druid_asi_8_2024", "name": "Ability Score Improvement", "description": "Gain Ability Score Improvement feat or other feat."}
    ],
    "10": [
      {"id": "druid_subclass_feature_10_2024", "name": "Subclass Feature", "description": "Gain subclass feature. Learns 1 additional cantrip."}
    ],
    "14": [
      {"id": "druid_subclass_feature_14_2024", "name": "Subclass Feature", "description": "Gain subclass feature."}
    ],
    "15": [
      {"id": "druid_improved_elemental_fury_2024", "name": "Improved Elemental Fury", "description": "Potent Spellcasting: Druid cantrips with range 10ft+ get +300ft range. Primal Strike: Extra damage increases to 2d8."}
    ],
    "18": [
      {"id": "druid_beast_spells_2024", "name": "Beast Spells", "description": "Can cast spells in Beast form (except those with costly/consumed material components)."}
    ],
    "19": [
      {"id": "druid_epic_boon_2024", "name": "Epic Boon", "description": "Gain an Epic Boon feat or other feat. (Boon of Dimensional Travel recommended)."}
    ],
    "20": [
      {"id": "druid_archdruid_2024", "name": "Archdruid", "description": "Evergreen Wild Shape (regain 1 Wild Shape use on Initiative if none left). Nature Magician (convert Wild Shape uses to spell slot, 2 levels per use, once per Long Rest). Longevity (age 1 year per 10 passed)."}
    ]
  },
